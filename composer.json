{
    "name": "askancy/laravel-smart-thumbnails",
    "description": "Content-aware thumbnails, gradient padding, responsive images and safe version cleanup for Laravel",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "thumbnails",
        "image",
        "crop",
        "smart-crop",
        "intervention",
        "resize",
        "avif",
        "webp",
        "dont-crop",
        "responsive-images"
    ],
  "authors": [
    {
      "name": "Daniele Caluri",
      "email": "daniele@caluri.it"
    }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0",
        "intervention/image": "^3.9",
        "ext-gd": "*"
    },
    "suggest": {
        "ext-imagick": "Optional Imagick image processing driver; compatible GD builds also support AVIF",
        "ext-redis": "For cache tagging support with Redis driver",
        "ext-memcached": "For cache tagging support with Memcached driver"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "autoload": {
        "psr-4": {
            "Askancy\\LaravelSmartThumbnails\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Askancy\\LaravelSmartThumbnails\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Askancy\\LaravelSmartThumbnails\\Providers\\ThumbnailServiceProvider"
            ],
            "aliases": {
                "Thumbnail": "Askancy\\LaravelSmartThumbnails\\Facades\\Thumbnail"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "test-unit": "vendor/bin/phpunit --testsuite Unit",
        "test-feature": "vendor/bin/phpunit --testsuite Feature",
        "analyse": "phpstan analyse src --level=5",
        "format": "php-cs-fixer fix src"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
