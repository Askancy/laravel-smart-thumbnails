{
    "name": "askancy/laravel-smart-thumbnails",
    "version": "1.1.0",
    "description": "Advanced thumbnail generation with smart cropping for Laravel applications",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "thumbnails",
        "image",
        "crop",
        "smart-crop",
        "intervention",
        "resize",
        "avif",
        "webp"
    ],
  "authors": [
    {
      "name": "Daniele Caluri",
      "email": "daniele@caluri.it"
    }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0|^11.0|^12.0",
        "intervention/image": "^3.9",
        "intervention/image-gd": "^1.0",
        "ext-gd": "*"
    },
    "suggest": {
        "intervention/image-imagick": "For better image quality, AVIF format support, and more features (requires ext-imagick)",
        "ext-imagick": "For advanced image processing capabilities and AVIF format support",
        "ext-redis": "For cache tagging support with Redis driver",
        "ext-memcached": "For cache tagging support with Memcached driver"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Askancy\\LaravelSmartThumbnails\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Askancy\\LaravelSmartThumbnails\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Askancy\\LaravelSmartThumbnails\\Providers\\ThumbnailServiceProvider"
            ],
            "aliases": {
                "Thumbnail": "Askancy\\LaravelSmartThumbnails\\Facades\\Thumbnail"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "test-unit": "vendor/bin/phpunit --testsuite Unit",
        "test-feature": "vendor/bin/phpunit --testsuite Feature",
        "analyse": "phpstan analyse src --level=5 || true",
        "format": "php-cs-fixer fix src || true"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

